<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nl_console_wizard_form" model="ir.ui.view">
        <field name="name">shopify.nl.console.wizard.form</field>
        <field name="model">shopify.nl.console.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Console (AI)">
                <group>
                    <field name="instance_id"/>
                    <field name="request" placeholder="e.g. import paid orders from the last 30 days"/>
                </group>
                <field name="parsed" invisible="not parsed" readonly="1" widget="text"/>
                <footer>
                    <button name="action_run" string="Run" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nl_console_wizard" model="ir.actions.act_window">
        <field name="name">Sync Console (AI)</field>
        <field name="res_model">shopify.nl.console.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
