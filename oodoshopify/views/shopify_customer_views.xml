<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_customer_form" model="ir.ui.view">
        <field name="name">shopify.customer.form</field>
        <field name="model">shopify.customer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_export_to_shopify" string="Push to Shopify" type="object" class="btn-primary"/>
                    <button name="action_credit_store_credit" string="Adjust Store Credit" type="object"
                            invisible="not shopify_customer_gid"/>
                    <field name="sync_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="instance_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="odoo_partner_id"/>
                        </group>
                        <group>
                            <field name="shopify_customer_id"/>
                            <field name="orders_count"/>
                            <field name="total_spent"/>
                            <field name="accepts_marketing"/>
                            <field name="verified_email"/>
                            <field name="tax_exempt"/>
                            <field name="is_company"/>
                            <field name="company_name" invisible="not is_company"/>
                            <field name="store_credit_balance"/>
                            <field name="last_synced"/>
                        </group>
                    </group>
                    <group string="Tags">
                        <field name="tags" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Metafields">
                            <div class="mb-2">
                                <button name="action_fetch_metafields" string="Fetch from Shopify"
                                        type="object" class="btn btn-sm btn-secondary me-1"
                                        icon="fa-download"/>
                                <button name="action_push_metafields" string="Push Modified"
                                        type="object" class="btn btn-sm btn-secondary"
                                        icon="fa-upload"/>
                            </div>
                            <field name="metafield_ids">
                                <list editable="bottom" decoration-warning="is_modified">
                                    <field name="namespace"/>
                                    <field name="key"/>
                                    <field name="value"/>
                                    <field name="value_type"/>
                                    <field name="is_modified" widget="boolean"/>
                                    <field name="mapped_odoo_field" optional="hide"/>
                                    <button name="action_push_to_shopify" string="Push"
                                            type="object" icon="fa-upload"
                                            invisible="not is_modified"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shopify_customer_list" model="ir.ui.view">
        <field name="name">shopify.customer.list</field>
        <field name="model">shopify.customer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="instance_id"/>
                <field name="orders_count"/>
                <field name="total_spent"/>
                <field name="odoo_partner_id"/>
                <field name="sync_status" widget="badge"
                       decoration-success="sync_status == 'synced'"
                       decoration-warning="sync_status == 'pending'"
                       decoration-danger="sync_status == 'error'"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_customer" model="ir.actions.act_window">
        <field name="name">Shopify Customers</field>
        <field name="res_model">shopify.customer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Add your first customer</p>
        <p>Run <b>Sync → Import Customers</b> to pull your Shopify customers, or click <b>New</b> to add one and push it up.</p>
    </field>
    </record>
</odoo>
