<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_instance_form" model="ir.ui.view">
        <field name="name">shopify.instance.form</field>
        <field name="model">shopify.instance</field>
        <field name="arch" type="xml">
            <form class="o_shopify_instance_form">
                <header>
                    <button name="action_connect_oauth" string="Connect with OAuth" type="object"
                            class="btn-primary" invisible="state == 'connected'"
                            help="Public-URL OAuth flow — for production / App Store. Needs an HTTPS-reachable Odoo."/>
                    <button name="action_test_connection" string="Test / Connect" type="object"
                            class="btn-primary" invisible="not access_token or state == 'connected'"
                            help="Verify the access token and mark the store connected."/>
                    <button name="action_test_connection" string="Test Connection" type="object"
                            invisible="state != 'connected'"/>
                    <button name="action_register_webhooks" string="Register Webhooks" type="object"
                            invisible="state != 'connected'"/>
                    <button name="action_sync_webhook_status" string="Sync Webhook Status" type="object"
                            invisible="state != 'connected'"/>
                    <button name="action_sync_locations" string="Sync Locations" type="object"
                            invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_customers" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="customer_count" widget="statinfo" string="Customers"/>
                        </button>
                        <button name="action_view_locations" type="object" class="oe_stat_button" icon="fa-map-marker">
                            <field name="location_count" widget="statinfo" string="Locations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="My Shopify Store"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="shop_domain" placeholder="my-store.myshopify.com"/>
                            <field name="api_key" password="True"
                                   help="OAuth: app's Client ID. Custom app: leave blank."/>
                            <field name="api_secret" password="True"
                                   help="OAuth: app's Client Secret. Custom app: leave blank."/>
                            <field name="access_token" password="True"
                                   readonly="state == 'connected'"
                                   placeholder="shpat_…  (paste a custom app Admin API token)"
                                   help="Fastest path for testing: create a custom app in your store, paste its Admin API access token here, then click 'Test / Connect'."/>
                            <field name="webhook_secret" password="True"/>
                        </group>
                        <group string="Settings">
                            <field name="company_id"/>
                            <field name="warehouse_id"/>
                            <field name="pricelist_id"/>
                            <field name="currency_id"
                                   help="Auto-detected when you click Test Connection."/>
                        </group>
                    </group>
                    <group string="Sync Options">
                        <group>
                            <field name="sync_orders"/>
                            <field name="sync_products"/>
                            <field name="product_matching_strategy"/>
                            <field name="new_product_status"/>
                        </group>
                        <group>
                            <field name="sync_customers"/>
                            <field name="sync_inventory"/>
                            <field name="inventory_qty_type"/>
                            <field name="realtime_inventory_push"/>
                        </group>
                    </group>
                    <group string="Inventory">
                        <field name="default_location_id"
                               help="Sync locations first, then select the Shopify location that maps to your main warehouse."/>
                    </group>
                    <group string="AI Content (optional)">
                        <field name="ai_api_key" password="True"
                               placeholder="sk-…  (OpenAI-compatible key)"/>
                        <field name="ai_base_url"/>
                        <field name="ai_model"/>
                    </group>
                    <group string="Accounting &amp; Payouts">
                        <group>
                            <field name="payout_journal_id"/>
                            <field name="shopify_clearing_account_id"/>
                        </group>
                        <group>
                            <field name="shopify_fee_account_id"/>
                        </group>
                    </group>
                    <group string="Order Import">
                        <group>
                            <field name="order_import_delay_minutes"/>
                            <field name="fallback_customer_id"/>
                        </group>
                        <group>
                            <field name="order_prefix"/>
                            <field name="import_paid_unfulfilled_only"/>
                        </group>
                    </group>
                    <group string="Abandoned Checkouts &amp; CRM">
                        <group>
                            <field name="abandoned_checkout_days_back"/>
                            <field name="crm_team_id"/>
                        </group>
                        <group>
                            <field name="crm_stage_id"/>
                            <field name="crm_won_stage_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Webhooks"
                              help="Toggle individual webhook topics. Click 'Register Webhooks' to apply changes.">
                            <field name="webhook_config_ids">
                                <list editable="bottom"
                                      decoration-success="state == 'active'"
                                      decoration-muted="state == 'disabled'"
                                      decoration-danger="state == 'error'"
                                      decoration-warning="state == 'draft'">
                                    <field name="topic_label" readonly="1"/>
                                    <field name="is_enabled" widget="boolean_toggle"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-warning="state == 'draft'"
                                           decoration-muted="state == 'disabled'"
                                           decoration-danger="state == 'error'"/>
                                    <field name="shopify_webhook_id" readonly="1" optional="hide"/>
                                    <field name="callback_path" readonly="1" optional="hide"/>
                                    <field name="last_error" readonly="1" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Currency → Pricelist Map"
                              help="Map each currency to a specific pricelist. Used for multi-currency orders and price push.">
                            <field name="pricelist_map_ids">
                                <list editable="bottom">
                                    <field name="currency_id"/>
                                    <field name="pricelist_id"/>
                                    <field name="pricelist_currency_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_shopify_instance_list" model="ir.ui.view">
        <field name="name">shopify.instance.list</field>
        <field name="model">shopify.instance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="shop_domain"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'error'"/>
                <field name="product_count"/>
                <field name="order_count"/>
                <field name="customer_count"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_instance" model="ir.actions.act_window">
        <field name="name">Shopify Instances</field>
        <field name="res_model">shopify.instance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                👋 Connect your first Shopify store
            </p>
            <p>
                Click <b>New</b> to add a store. Enter your shop domain and API
                credentials, then hit <b>Connect with OAuth</b> (or
                <b>Test Connection</b>) to link it.
            </p>
            <p>
                Once a store is connected, the rest of the app — Dashboard,
                Orders, Products, Sync, Marketing and more — unlocks automatically.
            </p>
        </field>
    </record>
</odoo>
