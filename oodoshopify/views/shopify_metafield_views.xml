<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Metafield inline list (embedded in product/customer/order forms) ── -->
    <record id="view_shopify_metafield_inline_list" model="ir.ui.view">
        <field name="name">shopify.metafield.inline.list</field>
        <field name="model">shopify.metafield</field>
        <field name="arch" type="xml">
            <list editable="bottom"
                  decoration-warning="is_modified"
                  decoration-muted="not shopify_metafield_id">
                <field name="namespace"/>
                <field name="key"/>
                <field name="value"/>
                <field name="value_type"/>
                <field name="is_modified" widget="boolean"/>
                <field name="mapped_odoo_field" optional="hide"/>
                <field name="updated_at" optional="hide"/>
                <button name="action_push_to_shopify" string="Push" type="object"
                        icon="fa-upload" invisible="not is_modified"/>
                <button name="action_delete_from_shopify" string="Delete" type="object"
                        icon="fa-trash" invisible="not shopify_metafield_id"/>
            </list>
        </field>
    </record>

    <!-- ── Standalone metafield list (for monitoring / bulk ops) ── -->
    <record id="view_shopify_metafield_list" model="ir.ui.view">
        <field name="name">shopify.metafield.list</field>
        <field name="model">shopify.metafield</field>
        <field name="arch" type="xml">
            <list decoration-warning="is_modified">
                <field name="instance_id"/>
                <field name="shopify_product_id"  optional="show"/>
                <field name="shopify_customer_id" optional="hide"/>
                <field name="shopify_order_id"    optional="hide"/>
                <field name="namespace"/>
                <field name="key"/>
                <field name="value"/>
                <field name="value_type"/>
                <field name="is_modified" widget="boolean"/>
                <field name="mapped_odoo_field" optional="show"/>
                <button name="action_push_to_shopify" string="Push" type="object"
                        icon="fa-upload" invisible="not is_modified"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_metafield" model="ir.actions.act_window">
        <field name="name">Shopify Metafields</field>
        <field name="res_model">shopify.metafield</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No metafields yet</p>
        <p>Open a product or customer and click <b>Fetch from Shopify</b> on the Metafields tab, or set up mappings under <b>Configuration → Metafield Mappings</b>.</p>
    </field>
    </record>

    <!-- ── Metafield Mapping ── -->
    <record id="view_shopify_metafield_mapping_form" model="ir.ui.view">
        <field name="name">shopify.metafield.mapping.form</field>
        <field name="model">shopify.metafield.mapping</field>
        <field name="arch" type="xml">
            <form string="Metafield Mapping">
                <sheet>
                    <group>
                        <group string="Shopify Side">
                            <field name="instance_id"/>
                            <field name="resource_type"/>
                            <field name="namespace" placeholder="custom"/>
                            <field name="key"       placeholder="material"/>
                            <field name="value_type"/>
                            <field name="direction"/>
                        </group>
                        <group string="Odoo Side">
                            <field name="odoo_model_id"/>
                            <field name="odoo_field_id"
                                   invisible="not odoo_model_id"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shopify_metafield_mapping_list" model="ir.ui.view">
        <field name="name">shopify.metafield.mapping.list</field>
        <field name="model">shopify.metafield.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="instance_id"/>
                <field name="resource_type"/>
                <field name="namespace"/>
                <field name="key"/>
                <field name="value_type"/>
                <field name="direction"/>
                <field name="odoo_model_id"/>
                <field name="odoo_field_id"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_metafield_mapping" model="ir.actions.act_window">
        <field name="name">Metafield Mappings</field>
        <field name="res_model">shopify.metafield.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Create your first metafield mapping</p>
        <p>Map Shopify metafields to Odoo fields so they sync automatically.</p>
    </field>
    </record>
</odoo>
