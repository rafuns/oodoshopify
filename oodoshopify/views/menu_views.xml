         until the first successful Shopify connection exists. -->
    <menuitem id="menu_shopify_operations" name="Operations"
              parent="menu_shopify_root" sequence="10"
              groups="shopify_group_connected"/>
    <menuitem id="menu_shopify_themes" name="Theme Manager"
              parent="menu_shopify_root" sequence="20"
              action="action_shopify_theme"
              groups="shopify_group_connected"/>
