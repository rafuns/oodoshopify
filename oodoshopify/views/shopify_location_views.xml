<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_location_form" model="ir.ui.view">
        <field name="name">shopify.location.form</field>
        <field name="model">shopify.location</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_default" string="Set as Default" type="object"
                            class="btn-primary"
                            invisible="is_default"/>
                    <button name="action_import_inventory_levels" string="Import Inventory Levels" type="object"/>
                    <button name="action_view_inventory_levels" string="View Levels" type="object"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inventory_levels" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="inventory_level_count" widget="statinfo" string="Items"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                            <span class="badge bg-success ms-2" invisible="not is_default">Default</span>
                        </h1>
                    </div>
                    <group>
                        <group string="Shopify">
                            <field name="instance_id"/>
                            <field name="shopify_location_id"/>
                            <field name="shopify_location_gid"/>
                            <field name="is_active"/>
                            <field name="fulfills_online"/>
                        </group>
                        <group string="Address">
                            <field name="address1"/>
                            <field name="address2"/>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="country_code"/>
                        </group>
                    </group>
                    <group string="Odoo Mapping">
                        <field name="odoo_warehouse_id"/>
                        <field name="odoo_location_id"/>
                        <field name="is_default"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shopify_location_list" model="ir.ui.view">
        <field name="name">shopify.location.list</field>
        <field name="model">shopify.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="instance_id"/>
                <field name="city"/>
                <field name="country_code"/>
                <field name="odoo_warehouse_id"/>
                <field name="is_active" widget="boolean"/>
                <field name="fulfills_online" widget="boolean"/>
                <field name="is_default" widget="boolean"/>
                <field name="inventory_level_count"/>
                <button name="action_set_default" string="Set Default" type="object" icon="fa-star"
                        invisible="is_default"/>
                <button name="action_import_inventory_levels" string="Import Levels" type="object" icon="fa-download"/>
            </list>
        </field>
    </record>

    <!-- Inventory levels list (child view) -->
    <record id="view_shopify_inventory_level_list" model="ir.ui.view">
        <field name="name">shopify.inventory.level.list</field>
        <field name="model">shopify.inventory.level</field>
        <field name="arch" type="xml">
            <list decoration-danger="quantity_diff &lt; 0" decoration-warning="quantity_diff &gt; 0">
                <field name="sku"/>
                <field name="shopify_product_variant_id"/>
                <field name="available_quantity"/>
                <field name="odoo_quantity"/>
                <field name="quantity_diff"/>
                <field name="shopify_inventory_item_id"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_location" model="ir.actions.act_window">
        <field name="name">Shopify Locations</field>
        <field name="res_model">shopify.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No locations yet</p>
        <p>Open your store under <b>Instances</b> and click <b>Sync Locations</b> to import Shopify locations / warehouses.</p>
    </field>
    </record>

    <record id="action_shopify_inventory_level" model="ir.actions.act_window">
        <field name="name">Inventory Levels</field>
        <field name="res_model">shopify.inventory.level</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No inventory levels yet</p>
        <p>Import stock per location with <b>Sync → Import Inventory Levels</b> (or the scheduled job).</p>
    </field>
    </record>
</odoo>
