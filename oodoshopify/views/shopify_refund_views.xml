<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_refund_form" model="ir.ui.view">
        <field name="name">shopify.refund.form</field>
        <field name="model">shopify.refund</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_credit_note" string="Create Credit Note" type="object"
                            class="btn-primary"
                            invisible="odoo_credit_note_id"/>
                    <button name="action_push_to_shopify" string="Push Refund to Shopify" type="object"
                            invisible="shopify_refund_id"
                            confirm="This will issue a real refund on Shopify. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,credit_note_created"/>
                </header>
                <sheet>
                    <group>
                        <group string="Shopify">
                            <field name="name"/>
                            <field name="instance_id"/>
                            <field name="shopify_refund_id"/>
                            <field name="shopify_order_id"/>
                            <field name="refund_date"/>
                        </group>
                        <group string="Amounts">
                            <field name="total_refunded"/>
                            <field name="currency"/>
                            <field name="odoo_sale_order_id"/>
                            <field name="odoo_credit_note_id"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Refund Lines">
                            <field name="line_ids">
                                <list>
                                    <field name="product_name"/>
                                    <field name="sku"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                    <field name="restock_type"/>
                                    <field name="odoo_product_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_shopify_refund_list" model="ir.ui.view">
        <field name="name">shopify.refund.list</field>
        <field name="model">shopify.refund</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="instance_id"/>
                <field name="shopify_order_id"/>
                <field name="refund_date"/>
                <field name="total_refunded"/>
                <field name="currency"/>
                <field name="odoo_credit_note_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'credit_note_created'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_refund" model="ir.actions.act_window">
        <field name="name">Shopify Refunds</field>
        <field name="res_model">shopify.refund</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No refunds yet</p>
        <p>Refunds arrive via webhook or order sync and can create Odoo credit notes.</p>
    </field>
    </record>
</odoo>
