<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_shipping_method_list" model="ir.ui.view">
        <field name="name">shopify.shipping.method.list</field>
        <field name="model">shopify.shipping.method</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="instance_id"/>
                <field name="shopify_shipping_title"/>
                <field name="shopify_shipping_code" optional="hide"/>
                <field name="odoo_carrier_id"/>
                <field name="add_shipping_line"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_shipping_method" model="ir.actions.act_window">
        <field name="name">Shipping Method Mapping</field>
        <field name="res_model">shopify.shipping.method</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Create your first shipping mapping</p>
        <p>Map Shopify shipping methods to Odoo delivery carriers.</p>
    </field>
    </record>
</odoo>
